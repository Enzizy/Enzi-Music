{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enzi Music",
  "version": "0.2.2",
  "identifier": "com.enzi.music",
  "build": {
    "frontendDist": "../ui/build",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Enzi Music",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Music",
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "libmpv-2.dll"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Enzizy/Enzi-Music/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZCOUFEQTcyRjNFNjJCNkYKUldSdksrYnpjdHFhK3ozdHJ3OXZTWDhsNWZpZm0vR2NaS0k2NzVBYjY4eURXZUxGREFLdzZBcUIK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "enzi-music"
}
