<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_previous"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#FAFAFA" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="@drawable/widget_toggle_background"
        android:contentDescription="@string/widget_play"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_play"
        android:tint="#141414" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:contentDescription="@string/widget_next"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_media_next"
        android:tint="#FAFAFA" />
</LinearLayout>
